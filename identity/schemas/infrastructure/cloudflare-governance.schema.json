{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.chitty.cc/infrastructure/cloudflare-governance.schema.json",
  "title": "CloudflareGovernanceObservation",
  "description": "Provisional Phase 0 observation shape for Cloudflare deployed-state evidence. This schema does not author ontology, register services, or authorize mutation. Ontology-bearing values must reference ChittyCanon terms or proposals.",
  "type": "object",
  "additionalProperties": false,
  "required": ["observationId", "observedAt", "source", "subject", "attributes"],
  "properties": {
    "observationId": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "objectType", "objectId"],
      "properties": {
        "provider": { "const": "cloudflare" },
        "accountId": { "type": "string", "minLength": 1 },
        "zoneId": { "type": "string", "minLength": 1 },
        "objectType": { "type": "string", "minLength": 1 },
        "objectId": { "type": "string", "minLength": 1 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalName"],
      "properties": {
        "canonicalRecordRef": { "type": "string", "minLength": 1 },
        "externalName": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string" },
        "path": { "type": "string", "pattern": "^/" }
      }
    },
    "ontologyRefs": {
      "type": "object",
      "description": "References to existing ChittyCanon term IDs or formally submitted proposal IDs. No unratified ontology strings may be encoded here.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "schemaRefs": {
      "type": "array",
      "items": { "type": "string", "format": "uri-reference" },
      "uniqueItems": true
    },
    "attributes": {
      "type": "object",
      "description": "Provider-native observed attributes retained without converting them into local ontology.",
      "additionalProperties": true
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relationshipTermRef", "targetRef"],
        "properties": {
          "relationshipTermRef": { "type": "string", "minLength": 1 },
          "targetRef": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string" },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "findingRefs": {
      "type": "array",
      "description": "References to generic observations or ratified finding terms; findings are not defined by this schema.",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
