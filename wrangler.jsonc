{
  "name": "chittyschema",
  "main": "connectivity/api/index.ts",
  "compatibility_date": "2026-03-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "0bc21e3a5a9de1a4cc843be9c3e98121",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "schema.chitty.cc/*",
      "zone_name": "chitty.cc"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SERVICE_NAME": "chittyschema"
  },
  "kv_namespaces": [
    {
      "binding": "REGISTRY_KV",
      "id": "c242ebbe796d4099b16c96dd687c0229"
    },
    {
      "binding": "BEACON_STORE",
      "id": "6978cc9c588d48f383a934fb3df9eed3"
    },
    {
      "binding": "CANON_CACHE",
      "id": "c006b33782094997a1f94b02eb99535a"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_COMMAND",
      "id": "6f6cba43540b430eb77045f79384ca00"
    },
    {
      "binding": "HYPERDRIVE_CORE",
      "id": "1d126444cff1416cb415447e6cc6d15a"
    },
    {
      "binding": "HYPERDRIVE_COUNSEL",
      "id": "38d25002523142fcbe91631a08254854"
    },
    {
      "binding": "HYPERDRIVE_EVIDENCE",
      "id": "5057f7a63d2a4a15b19ac45ce44a05c1"
    },
    {
      "binding": "HYPERDRIVE_FINANCE",
      "id": "89158b50e55a4d5d9279b5d5c890ea7b"
    },
    {
      "binding": "HYPERDRIVE_LEDGER",
      "id": "bd15768d341944c2b8bc6578f795df9a"
    },
    {
      "binding": "HYPERDRIVE_RESOLUTION",
      "id": "df36b0552d9e4ffdbf63de8861dabece"
    },
    {
      "binding": "HYPERDRIVE_TRACE",
      "id": "a41987b2faff4acc92d4570117c65f94"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CANONICAL_SCHEMAS",
      "bucket_name": "chittyschema-canonical-schemas"
    },
    {
      "binding": "DRIFT_ARCHIVE",
      "bucket_name": "chittyschema-drift-archive"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DRIFT_QUEUE",
        "queue": "chittyschema-drift-scan"
      }
    ],
    "consumers": [
      {
        "queue": "chittyschema-drift-scan",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "chittyschema-drift-scan-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "tail_consumers": [
    {
      "service": "chittytrack"
    }
  ],
  "build": {
    "command": "npm run build:api"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "destinations": [
        "chittytrack-logs"
      ]
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "destinations": [
        "chittytrack-traces"
      ],
      "persist": false
    }
  }
}