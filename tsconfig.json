{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./identity/dist",
    "rootDir": "./identity/src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["identity/src/*"],
      "@/types/*": ["identity/src/types/*"],
      "@/validators/*": ["identity/src/validators/*"],
      "@/generated/*": ["identity/src/generated/*"]
    }
  },
  "include": ["identity/src/**/*"],
  "exclude": ["node_modules", "identity/dist", "**/*.test.ts"]
}
