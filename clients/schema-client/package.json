{
  "name": "@chittyos/schema-client",
  "version": "0.1.0",
  "description": "Attachable auto-syncing schema node for ChittyOS consumer services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CHITTYFOUNDATION/chittyschema.git",
    "directory": "clients/schema-client"
  },
  "keywords": ["chittyos", "schema", "validation", "drift-detection"],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
